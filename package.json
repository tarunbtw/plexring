{
  "name": "plexring",
  "version": "0.1.0",
  "description": "Ultra-low latency lock-free SharedArrayBuffer SPSC worker pool for Node.js micro-tasks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test 'test/**/*.test.ts'",
    "bench": "node --import tsx/esm bench/vs-piscina.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "worker-threads",
    "sharedarraybuffer",
    "lock-free",
    "spsc",
    "concurrency",
    "performance",
    "piscina"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "piscina": "^5.3.2",
    "tinybench": "^6.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
